# Copy to .env (or export directly) before running `go run ./cmd/api`.

# Postgres connection string.
ATLAS_DATABASE_URL=postgres://atlas:atlas_dev@localhost:5432/atlas?sslmode=disable

# Zitadel instance base URL — JWKS lives at <issuer>/oauth/v2/keys.
ZITADEL_ISSUER=https://auth.black-tulip.nl

# Frontend origin, used for CORS.
ATLAS_FRONTEND_URL=http://localhost:3003

# GitHub personal access token used by output.type: github templates
# (needs repo scope or contents:write). Read at execute time from the env var
# named in the template's output.github.tokenEnv (default GITHUB_TOKEN).
# GITHUB_TOKEN=ghp_your_token_here
