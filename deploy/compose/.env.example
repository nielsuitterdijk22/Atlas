# Atlas deployment environment variables.
# Copy to .env and fill in the required values:
#   cp deploy/compose/.env.example deploy/compose/.env
#
# This stack assumes Quill (and its shared Zitadel instance + Caddy reverse
# proxy) is already deployed on the same VM. See deploy/compose/README.md.

# ---------------------------------------------------------------------------
# Postgres (Atlas's own database — separate from Quill's)
# ---------------------------------------------------------------------------

POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# ---------------------------------------------------------------------------
# Atlas API (backend)
# ---------------------------------------------------------------------------

# Runtime environment. Always "production" on the VM.
ATLAS_ENV=production

# Public URL Atlas's frontend is served at, used for CORS.
ATLAS_FRONTEND_URL=https://atlas.example.com

# GitHub personal access token used by output.type: github templates
# (needs repo scope or contents:write). Leave empty if no template uses it.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Zitadel — shared with Quill, not a separate instance
# ---------------------------------------------------------------------------

# Same Zitadel issuer Quill's --profile zitadel stack serves (or any other
# Zitadel instance you've already stood up). Do not run a second Zitadel.
ZITADEL_ISSUER=https://auth.example.com

# Zitadel application (type: User Agent / PKCE) registered for Atlas. Register
# a redirect URI of https://atlas.example.com/api/auth/callback/zitadel in the
# Zitadel console, then fill in the IDs it gives you.
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=

# Zitadel service-account token for Management API calls. Optional — only
# needed if Atlas templates provision Zitadel resources.
ZITADEL_MANAGEMENT_TOKEN=

# ---------------------------------------------------------------------------
# Quill integration (optional)
# ---------------------------------------------------------------------------

# Quill's public backend API. Leave empty to disable the integration.
QUILL_API_BASE_URL=https://quill.example.com
# Public host Quill's wrapped Forgejo is reachable at, used to build git clone
# URLs (Quill's repo API doesn't return one). Matches Quill's own
# QUILL_FORGEJO_PUBLIC_URL.
QUILL_FORGEJO_PUBLIC_URL=https://git.example.com

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------

# NextAuth's session encryption secret. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Sibling app URLs for the top-left app switcher. Leave any of them blank to
# show that tile disabled instead of linking out. Baked in at build time.
NEXT_PUBLIC_QUILL_URL=https://quill.example.com
NEXT_PUBLIC_TEMPO_URL=https://tempo.example.com
NEXT_PUBLIC_FORGE_URL=https://forge.example.com

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Docker network Quill's compose stack creates (project name "quill" ->
# "quill_default" by default). Atlas's web container joins it so Quill's
# Caddy can reverse_proxy to it by container name. Only change this if you
# renamed Quill's compose project.
EDGE_NETWORK_NAME=quill_default
