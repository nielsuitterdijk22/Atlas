#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

# Frontend: Vite + React, plain JavaScript (no tsconfig.json, so no tsc).
if [ -d frontend ]; then
  cd frontend
  if [ ! -d node_modules ]; then
    echo "== npm ci (frontend)"
    npm ci
  fi
  if [ -f tsconfig.json ]; then
    echo "== type-check (frontend)"
    npx tsc --noEmit
  fi
  for script in lint type-check test build; do
    if grep -q "\"$script\"" package.json; then
      echo "== $script (frontend)"
      npm run "$script"
    fi
  done
  cd ..
fi

echo "== Yaly.Api: skipped (no .NET toolchain in the sandbox)"
