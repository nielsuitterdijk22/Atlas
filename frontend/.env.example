# Copy to .env.local before running `npm run dev`.

# Go backend, used for server-side rendering and the /api/* rewrite proxy.
ATLAS_API_BASE_URL=http://localhost:8080

# NextAuth's own session encryption secret (not the Zitadel client secret —
# Zitadel is a public PKCE client, so it has none). Generate with:
#   openssl rand -hex 32
NEXTAUTH_SECRET=

# Zitadel application (type: User Agent / PKCE). Register a redirect URI of
# http://localhost:3003/api/auth/callback/zitadel in the Zitadel console.
NEXT_PUBLIC_ZITADEL_ISSUER=https://auth.black-tulip.nl
NEXT_PUBLIC_ZITADEL_CLIENT_ID=
NEXT_PUBLIC_ZITADEL_PROJECT_ID=
